{
  "actorSpecification": 1,
  "name": "url-to-pdf-screenshot",
  "title": "Website Screenshot & URL to PDF: Full Page, HTML to PDF",
  "description": "Take full-page website screenshots (PNG, JPEG, WebP) and convert URLs or your own HTML to PDF in headless Chrome: desktop, tablet or mobile, A4/Letter, cookie banners hidden. Files stored with shareable links. $2 per 1,000 screenshots.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Files",
          "transformation": {
            "fields": [
              "url",
              "htmlName",
              "status",
              "title",
              "screenshotUrl",
              "pdfUrl",
              "error"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "URL",
                "format": "link"
              },
              "htmlName": {
                "label": "HTML doc"
              },
              "status": {
                "label": "HTTP",
                "format": "number"
              },
              "title": {
                "label": "Title"
              },
              "screenshotUrl": {
                "label": "Screenshot",
                "format": "image"
              },
              "pdfUrl": {
                "label": "PDF",
                "format": "link"
              },
              "error": {
                "label": "Error"
              }
            }
          }
        }
      }
    }
  }
}
